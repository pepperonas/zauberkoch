{#- Double-opt-in verification. Vars: name, verify_url, valid_hours. -#}
{% extends "_layout.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block title %}Bestätige deine E-Mail für Zauberkoch{% endblock %}
{% block preheader %}Nur noch ein Klick — bestätige deine E-Mail und der Zauberkoch kann loslegen.{% endblock %}
{% block heading %}Hallo{% if name %} {{ name }}{% endif %}, willkommen! <span style="color:#f0b429;">&#10022;</span>{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
  <td class="zk-pad" style="padding:0 40px 8px 40px;">
    <p class="zk-text" style="margin:0 0 12px 0; font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:16px; line-height:1.6; color:#e0e5da;">
      Schön, dass du dabei bist. Bestätige nur noch kurz deine E-Mail-Adresse — danach zaubert der Zauberkoch dir Rezepte und Drinks auf Kochbuch-Niveau, live Zutat für Zutat.
    </p>
  </td>
</tr></table>
{{ m.cta(verify_url, "E-Mail bestätigen") }}
{{ m.fallback(verify_url, "Falls der Button nicht funktioniert, kopiere diesen Link in deinen Browser:") }}
{{ m.note("Der Link ist <strong style=\"color:#e0e5da;\">" ~ valid_hours ~ " Stunden</strong> gültig. Hast du dich nicht bei Zauberkoch registriert? Dann ignoriere diese E-Mail einfach — ohne Bestätigung wird kein Konto angelegt.") }}
{% endblock %}
