{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "export:motifs": "npx esbuild scripts/export-motifs.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.export-motifs.mjs && node .export-motifs.mjs && rm -f .export-motifs.mjs",
    "measure:motifs": "npx esbuild scripts/measure-motifs.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.measure-motifs.mjs && node .measure-motifs.mjs && rm -f .measure-motifs.mjs",
    "gen:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.77.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepperonas/zauberkoch-pwa.git"
  },
  "overrides": {
    "postcss": "^8.5.18"
  }
}
