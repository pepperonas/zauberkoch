{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "export:motifs": "npx esbuild scripts/export-motifs.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.export-motifs.mjs && node .export-motifs.mjs && rm -f .export-motifs.mjs",
    "measure:motifs": "npx esbuild scripts/measure-motifs.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=.measure-motifs.mjs && node .measure-motifs.mjs && rm -f .measure-motifs.mjs",
    "gen:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@tanstack/react-query": "^5.103.2",
    "motion": "^12.42.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepperonas/zauberkoch.git"
  },
  "overrides": {
    "postcss": "^8.5.18"
  }
}
